# Copy to .env. All-empty secrets start honest, temporary demo mode.
# Never commit secrets or put them in NEXT_PUBLIC_ variables.
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
# Neon dashboard > project > Connect. Use a pooled PostgreSQL connection URL.
DATABASE_URL=
# Neon deploy/env pull provides this direct URL for migrations. Never expose it.
DATABASE_URL_UNPOOLED=

OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
TIMEZONE=UTC
# Optional: true forces temporary demo storage even if provider secrets exist.
DEMO_MODE=false

# Local development only. Non-loopback URLs fail closed in this mode.
AUTH_MODE=local
# Hosting requires Cloudflare Access plus these non-secret settings.
# AUTH_MODE=cloudflare-access
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
