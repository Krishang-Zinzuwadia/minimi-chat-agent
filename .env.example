# Required for live mode. Leave both blank for the clearly labeled offline demo.
OPENAI_API_KEY=
TAVILY_API_KEY=
# Any OpenAI-compatible tool-calling model can be used. No credentials are bundled.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
PORT=3000
# The app deliberately binds to loopback. Do not expose without authentication.
DATA_DIR=./data
TIMEZONE=UTC
# Optional: force offline demo even when keys are present.
DEMO_MODE=false
